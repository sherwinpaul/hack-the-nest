# Copy to .env and fill in. Never commit .env.

# --- LLMs (hybrid) ---
# Without OPENAI_API_KEY, the "openai" roles fall back to Gemini so you can build now.
OPENAI_API_KEY=
GEMINI_API_KEY=          # comma-separated for failover: key1,key2
OPENAI_MODEL=gpt-5-mini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# --- Search / data ---
EXA_API_KEY=             # optional: without it Exa MCP uses its rate-limited free tier
# Verify these endpoints at kickoff; they come from public listings.
EXA_MCP_URL=https://mcp.exa.ai/mcp
KIWI_MCP_URL=https://mcp.kiwi.com
DUFFEL_ACCESS_TOKEN=          # use a duffel_test_... token only
# In-app payments (test mode only): https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Runtime ---
# replay = deterministic recorded storm (use for the demo); live = real APIs
DATA_MODE=replay
REPLAY_SCENARIO=storm_ord
